<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:keepScreenOn="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/back_to_songs" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/tme_back" />
        <TextView android:id="@+id/song_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="24sp" />
        <TextView android:id="@+id/singing_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp" android:textSize="18sp" />
        <TextView android:id="@+id/preparation_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp" />
        <TextView android:id="@+id/lyric_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/pitch_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/failure_reason" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="#B3261E" />
        </LinearLayout>
        <LinearLayout android:id="@+id/scoring_area" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <io.agora.karaoke_view_ex.ScoringView android:id="@+id/scoring_view"
                style="@style/KaraokeScoringView" />
            <io.agora.karaoke_view_ex.LyricsView android:id="@+id/lyrics_view"
                style="@style/KaraokeLyricsView" />
            <TextView android:id="@+id/score_summary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginStart="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/play_position" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp" android:text="00:00" />
        <Button android:id="@+id/pause_resume" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/pause" android:enabled="false" />
        <Button android:id="@+id/toggle_track" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/play_accompany" android:enabled="false" />
        <Button android:id="@+id/restart_song" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/tme_restart" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
